# Public site origin (used for metadata, Open Graph and canonical URLs).
# NEXT_PUBLIC_* values are embedded in the bundle at build time: never put secrets here.
# Production uses the official domain: NEXT_PUBLIC_SITE_URL=https://lavieco.io.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudinary cloud name of the matching environment (dev here, ADR-0020). Not a secret: it is
# part of every image URL. The API key/secret live in content-service only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- server only (read through src/lib/env.ts) ---

# identity-service on the private network (never exposed to the Internet).
IDENTITY_SERVICE_URL=http://127.0.0.1:4001
# program-service on the private network (events: /chuong-trinh).
PROGRAM_SERVICE_URL=http://127.0.0.1:4004
# content-service on the private network (member avatar; later handbook, works, QR).
CONTENT_SERVICE_URL=http://127.0.0.1:4002
# PRIVATE Ed25519 JWK of `web`, signing its service tokens (ADR-0018). Its PUBLIC half
# goes into SERVICE_TOKEN_TRUSTED_KEYS of the services web calls.
SERVICE_TOKEN_PRIVATE_JWK=

# Google sign-in for members (ADR-0016). The client ID is not secret; the client SECRET
# lives in identity-service only. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Cloudflare Turnstile on public forms: prepared, switched on when spam shows up.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HMAC key for POST /api/revalidate (same value as REVALIDATE_SECRET of program-service).
# base64 of 32 random bytes; empty = the endpoint refuses every call.
REVALIDATE_SECRET=

# Origin of the admin app: the only page allowed to embed the event preview in an iframe.
ADMIN_APP_URL=http://localhost:3001

LOG_LEVEL=info

# --- LaviAgent (docs/07, ADR-0024): AI recycling assistant ---
# Which model answers: gemini (today) | lavieco (own model, not implemented yet).
LAVIAGENT_AI_PROVIDER=gemini
# offline = fixed data only, no AI call (demo without network). online otherwise.
LAVIAGENT_DEMO_MODE=online
# SECRET. Google AI Studio key, server only. Empty = LaviAgent runs offline.
GEMINI_API_KEY=
# Model names change over time (404 = retired for new users): list them with
# GET https://generativelanguage.googleapis.com/v1beta/models (docs/07 §7).
# Rate-limited on the free tier? Switch to a Flash-Lite model.
GEMINI_MODEL=gemini-3.8-flash
# Thinking before answering (chat + analyze): off | minimal | low | medium | high. Lower is
# faster; some models refuse "minimal" (HTTP 400 in the server log).
GEMINI_THINKING=low
# PITCH ONLY: every photo is analysed as a seashell (no model call), chat stays real.
# Keep false in production (docs/07 §4.4).
LAVIAGENT_DEMO_VO_SO=false
