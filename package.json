{
  "name": "lavieco",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "env:init": "node infra/scripts/env-init.mjs",
    "env:check": "node infra/scripts/env-check.mjs",
    "dev:infra": "docker compose -f infra/compose/compose.dev.yml --env-file .env.local up -d --wait",
    "dev:infra:down": "docker compose -f infra/compose/compose.dev.yml --env-file .env.local down",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run start -w @lavieco/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "deps:check": "depcruise apps/web services packages --config .dependency-cruiser.cjs && depcruise apps/admin --config .dependency-cruiser.admin.cjs",
    "db:migrate": "turbo run db:migrate",
    "gen:openapi": "turbo run gen:openapi",
    "admin:create": "npm run admin:create -w @lavieco/identity-service --",
    "keys:generate": "npm run build -w @lavieco/identity-service && npm run keys:generate -w @lavieco/identity-service --",
    "payos:webhook": "npm run build -w @lavieco/program-service && npm run payos:webhook -w @lavieco/program-service --",
    "mail:test": "node infra/scripts/mail-test.mjs",
    "mail:preview": "node infra/scripts/mail-preview.mjs",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "dependency-cruiser": "^16.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0"
  }
}
