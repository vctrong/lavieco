# Root environment for `npm run dev:infra` (infra/compose/compose.dev.yml).
# Copy with `npm run env:init`, then edit `.env.local` (never committed).
# Each app/service has its own `.env.example` next to its package.json.

MONGO_PORT=27017

# Local MinIO only. Pick any values; production object storage has its own credentials.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
