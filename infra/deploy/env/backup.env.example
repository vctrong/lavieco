# Backups by infra/deploy/scripts/mongo-backup.sh. Copy to /opt/lavieco/env/backup.env (chmod 600).
# Connection string of a user with the `backup` role (read-only on lavieco_identity,
# lavieco_content, lavieco_program), never a service account:
#   Atlas:         mongodb+srv://<user>:<password>@<cluster>/
#   profile mongo: mongodb://<user>:<password>@mongo:27017/?replicaSet=rs0&authSource=admin
BACKUP_MONGODB_URI=
