# Variables of compose.prod.yml itself (not of the containers). Copy to /opt/lavieco/compose.env.
# No secret here. deploy.sh rewrites IMAGE_TAG after each successful deploy.

# Owner of the GHCR images: ghcr.io/<GHCR_OWNER>/lavieco-<name> (lowercase).
GHCR_OWNER=vctrong
# Commit SHA of the images currently deployed.
IMAGE_TAG=

# Directories on the server (outside the repo).
LAVIECO_ENV_DIR=/opt/lavieco/env
LAVIECO_CERT_DIR=/opt/lavieco/certs

# Uncomment to run the optional self-hosted MongoDB (profile "mongo").
# COMPOSE_PROFILES=mongo
