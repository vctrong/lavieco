# OPTIONAL self-hosted MongoDB (compose profile "mongo"; production uses Atlas by default).
# Copy to /opt/lavieco/env/mongo.env (chmod 600) only if that profile is enabled.
# Root account used to initialise the replica set and to create one user per service
# (runbook §9). The services never connect as root.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
