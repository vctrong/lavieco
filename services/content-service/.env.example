# content-service. Copy with `npm run env:init`; real values only in `.env.local` (never committed).

NODE_ENV=development
PORT=4002
LOG_LEVEL=info

# Local replica set from `npm run dev:infra`. Production: Atlas (Singapore), user `svc_content` with rights on lavieco_content only.
# Atlas during development: only `lavieco_content_dev`, with an Atlas user limited to *_dev (docs/04 §11.1).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=lavieco_content

# Public JWKs of the callers allowed to use a service token (ADR-0018):
# {"program-service": {...}} for attach/release; later "identity-service" for account deletion (UC-29).
SERVICE_TOKEN_TRUSTED_KEYS=
# Staff and member access tokens are verified against identity-service's JWKS.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json

# Cloudinary DEV product environment (ADR-0020); production has its own environment and keys.
# The API secret never leaves this service. Images go under lavieco/dev (lavieco/prod in production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
