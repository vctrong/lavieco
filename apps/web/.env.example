# Public site origin (used for metadata, Open Graph and canonical URLs).
# NEXT_PUBLIC_* values are embedded in the bundle at build time: never put secrets here.
# Production uses the official domain: NEXT_PUBLIC_SITE_URL=https://lavieco.io.vn
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- server only (read through src/lib/env.ts) ---

# identity-service on the private network (never exposed to the Internet).
IDENTITY_SERVICE_URL=http://127.0.0.1:4001
# program-service on the private network (events: /chuong-trinh).
PROGRAM_SERVICE_URL=http://127.0.0.1:4004
# PRIVATE Ed25519 JWK of `web`, signing its service tokens (ADR-0018). Its PUBLIC half
# goes into SERVICE_TOKEN_TRUSTED_KEYS of the services web calls.
SERVICE_TOKEN_PRIVATE_JWK=

# Google sign-in for members (ADR-0016). The client ID is not secret; the client SECRET
# lives in identity-service only. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Cloudflare Turnstile on public forms: prepared, switched on when spam shows up.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# HMAC key for POST /api/revalidate (same value as REVALIDATE_SECRET of program-service).
# base64 of 32 random bytes; empty = the endpoint refuses every call.
REVALIDATE_SECRET=

# Origin of the admin app: the only page allowed to embed the event preview in an iframe.
ADMIN_APP_URL=http://localhost:3001

LOG_LEVEL=info
