# admin (apps/admin) in production. Copy to /opt/lavieco/env/admin.env on the server
# (chmod 600). Real values NEVER go into the repo. Meaning: docs/06-bien-moi-truong.md.
#
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME is NOT read here: it is a public build arg inlined into
# the image (repository variable of .github/workflows/release.yml). PORT/HOSTNAME are set
# by the image (3001, 0.0.0.0).

NODE_ENV=production
LOG_LEVEL=info

# Services on the private compose network (never through the Internet).
IDENTITY_SERVICE_URL=http://identity-service:4001
PROGRAM_SERVICE_URL=http://program-service:4004
CONTENT_SERVICE_URL=http://content-service:4002

# Origin of web: the event preview is rendered there inside an iframe.
WEB_APP_URL=https://lavieco.io.vn

# SERVICE TOKEN KEY of caller "admin": the PRIVATE_JWK line of `npm run keys:generate -- admin`,
# wrapped in single quotes. Its PUBLIC_JWK goes under "admin" in SERVICE_TOKEN_TRUSTED_KEYS of
# identity-service.env and program-service.env. The private JWK lives here and nowhere else.
SERVICE_TOKEN_PRIVATE_JWK=
