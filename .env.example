# Root environment for `npm run dev:infra` (infra/compose/compose.dev.yml).
# Copy with `npm run env:init`, then edit `.env.local` (never committed).
# Each app/service has its own `.env.example` next to its package.json.

# Local MongoDB replica set. Development never points at the production database (docs/04 §11.1).
MONGO_PORT=27017

# Images use the Cloudinary DEV environment (ADR-0020): keys live in services/content-service/.env.local.

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
