# program-service. Copy with `npm run env:init`; real values only in `.env.local` (never committed).

NODE_ENV=development
PORT=4004
LOG_LEVEL=info

# Local replica set from `npm run dev:infra`. Production: Atlas (Singapore), user `svc_program` with rights on lavieco_program only.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_DB=lavieco_program
# Atlas dev instead (needs your IP in the Atlas allowlist and a *_dev database, docs/dev-local.md):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=lavieco_program_dev

# Public JWKs of the BFFs allowed to call this service: {"web": {...}, "admin": {...}} (ADR-0018)
SERVICE_TOKEN_TRUSTED_KEYS=
# Staff/member access tokens are verified against identity-service's JWKS.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
# identity-service on the private network: audit events (registration export, refunds) go there
# through the outbox, signed with SERVICE_TOKEN_PRIVATE_JWK (ADR-0021).
IDENTITY_SERVICE_URL=http://127.0.0.1:4001

# content-service on the private network: event images are attached/released there (ADR-0020).
CONTENT_SERVICE_URL=http://127.0.0.1:4002
# PRIVATE Ed25519 JWK of program-service, signing its service tokens (ADR-0018). Its PUBLIC half
# goes into SERVICE_TOKEN_TRUSTED_KEYS of content-service as "program-service".
SERVICE_TOKEN_PRIVATE_JWK=

# Cache revalidation of public event pages on `web` (HMAC, same value as REVALIDATE_SECRET in apps/web).
WEB_APP_URL=http://localhost:3000
REVALIDATE_SECRET=

# HMAC key of the order links in ticket emails (/ve/[token], payment page): base64 of 32 random
# bytes (RANDOM_32B of keys:generate). Changing it invalidates every link already emailed.
TICKET_LINK_SECRET=

# Mail (ticket emails): Mailpit in development (http://localhost:8025). Real delivery:
# fill SMTP_* and MAIL_FROM as in docs/06 "Gửi email thật (SMTP)" (Gmail App Password
# for dev only; a transactional provider on lavieco.io.vn with SPF/DKIM for prod), then
# run npm run mail:test -- <email>. SMTP_USER and SMTP_PASS go together; 465 needs
# SMTP_SECURE=true.
# The whole mail block MUST EQUAL services/identity-service/.env.local.
MAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LAVIECO <no-reply@lavieco.io.vn>"
# Sender on the SMTP_* route (the Gmail address itself). Empty = MAIL_FROM.
MAIL_FROM_FALLBACK=
MAIL_REPLY_TO=
# Brevo in front of SMTP_* (ADR-0023). Empty BREVO_SMTP_KEY = SMTP_* only (Mailpit).
# With a key, MAIL_FROM_FALLBACK is required. Test one route:
# npm run mail:test -- <email> --provider=brevo|gmail
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_COOLDOWN_MINUTES=15

# payOS payment channel (my.payos.vn → Kênh thanh toán → the channel → Thông tin tích hợp).
# All three or none: empty = paid events refuse bookings, free events still work.
# The checksum key verifies webhooks; it never leaves this service (ADR-0015).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
