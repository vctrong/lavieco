{
  "name": "@lavieco/api-clients",
  "version": "0.1.0",
  "private": true,
  "description": "Typed HTTP clients to the services: service tokens, timeouts, retries, Problem Details (docs/04 §4.2).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lavieco/shared": "*",
    "jose": "^5.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lavieco/config": "*",
    "@types/node": "^24",
    "eslint": "^9",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
