# web (apps/web) in production. Copy to /opt/lavieco/env/web.env on the server
# (chmod 600, owned by the deploy user). Real values NEVER go into the repo.
# Meaning of every variable: docs/06-bien-moi-truong.md. Keys: docs/runbooks/deploy-vps.md §4.
#
# NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME are NOT read here: they are
# public build args inlined into the image (repository variables of .github/workflows/release.yml).
# PORT/HOSTNAME are set by the image (3000, 0.0.0.0).

NODE_ENV=production
LOG_LEVEL=info

# Services on the private compose network (never through the Internet).
IDENTITY_SERVICE_URL=http://identity-service:4001
PROGRAM_SERVICE_URL=http://program-service:4004
CONTENT_SERVICE_URL=http://content-service:4002

# Origin of admin: the only page allowed to frame the event preview.
ADMIN_APP_URL=https://admin.lavieco.io.vn

# SERVICE TOKEN KEY of caller "web": the PRIVATE_JWK line of `npm run keys:generate -- web`,
# wrapped in single quotes. Its PUBLIC_JWK goes under "web" in SERVICE_TOKEN_TRUSTED_KEYS of
# identity-service.env and program-service.env. The private JWK lives here and nowhere else.
SERVICE_TOKEN_PRIVATE_JWK=

# MUST EQUAL REVALIDATE_SECRET in program-service.env (base64 of 32 random bytes,
# a RANDOM_32B value of keys:generate). HMAC of the /api/revalidate webhook.
REVALIDATE_SECRET=

# Google sign-in (ADR-0016). MUST EQUAL the same two variables in identity-service.env;
# the redirect URI must also be registered in the Google console. Empty = disabled.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=https://lavieco.io.vn/api/auth/google/callback

# Cloudflare Turnstile on public forms.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# LaviAgent (docs/07, ADR-0024). Empty GEMINI_API_KEY = offline demo data only.
LAVIAGENT_AI_PROVIDER=gemini
LAVIAGENT_DEMO_MODE=online
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
