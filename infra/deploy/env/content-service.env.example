# content-service in production. Copy to /opt/lavieco/env/content-service.env on the
# server (chmod 600). Real values NEVER go into the repo. Meaning: docs/06-bien-moi-truong.md.

NODE_ENV=production
PORT=4002
LOG_LEVEL=info

# Atlas (Singapore), user `svc_content` with rights on lavieco_content ONLY.
MONGODB_URI=
MONGODB_DB=lavieco_content

# PUBLIC JWKs of the callers allowed to use a service token here (one JSON object, single quotes):
#   '{"program-service": <PUBLIC_JWK of program-service>}'
# = the public half of SERVICE_TOKEN_PRIVATE_JWK in program-service.env. web/admin call this
# service with user tokens, so they need no entry (docs/06 "Service token").
SERVICE_TOKEN_TRUSTED_KEYS=

# identity-service JWKS on the private network (user tokens of staff and members).
IDENTITY_JWKS_URL=http://identity-service:4001/.well-known/jwks.json

# Cloudinary PRODUCTION product environment (ADR-0020), never the dev one.
# CLOUDINARY_CLOUD_NAME MUST EQUAL the NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME build variable of
# web and admin. The API secret lives here only. Run `media:setup` once (runbook §5).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
