# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/

# original (unoptimized) source images, kept locally only
docs/brand/originals/

# turborepo
.turbo/

# build output of packages and services
dist/
tsup.config.bundled_*

# key material and one-time secrets: never committed (docs/runbooks/chay-local.md)
*.key
*.jwk
*.jwk.json
*-keys.json
*recovery-codes*
secrets/

# local working material, kept out of the repo
docs_temp/
docs/design/png tach nen/
docs/design/png vien trang/
