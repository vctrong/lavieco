{
  "name": "@lavieco/service-kit",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS building blocks shared by the services: config, auth guard, Problem Details, health, Mongo, outbox, email (docs/04 §4.2).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ports": {
      "import": {
        "types": "./dist/ports/index.d.ts",
        "default": "./dist/ports/index.js"
      },
      "require": {
        "types": "./dist/ports/index.d.cts",
        "default": "./dist/ports/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lavieco/observability": "*",
    "@lavieco/shared": "*",
    "jose": "^5.10.0",
    "nodemailer": "^7.0.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "express": "^5",
    "mongoose": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@lavieco/config": "*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.13.0",
    "@types/express": "^5",
    "@types/node": "^24",
    "@types/nodemailer": "^7.0.0",
    "eslint": "^9",
    "express": "^5",
    "mongoose": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.0",
    "tsup": "^8",
    "typescript": "^5",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0"
  }
}
