# content-service. Copy with `npm run env:init`; real values only in `.env.local` (never committed).

NODE_ENV=development
PORT=4002
LOG_LEVEL=info

# Local replica set from `npm run dev:infra`. Production: Atlas (Singapore), user `svc_content` with rights on lavieco_content only.
# Atlas during development: only `lavieco_content_dev`, with an Atlas user limited to *_dev (docs/04 §11.1).
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_DB=lavieco_content
# Atlas dev instead (needs your IP in the Atlas allowlist and a *_dev database, docs/dev-local.md):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=lavieco_content_dev

# Public JWKs of the callers allowed to use a service token (ADR-0018):
# {"program-service": {...}} for attach/release, "web" for the public handbook (ADR-0029);
# later "identity-service" for account deletion (UC-29).
SERVICE_TOKEN_TRUSTED_KEYS=
# Staff and member access tokens are verified against identity-service's JWKS.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json

# Cloudinary DEV product environment (ADR-0020); production has its own environment and keys.
# The API secret never leaves this service. Images go under lavieco/dev (lavieco/prod in production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# identity-service on the private network: handbook audit events and staff alerts go there
# through the outbox, signed with SERVICE_TOKEN_PRIVATE_JWK (ADR-0021, ADR-0027, ADR-0029).
IDENTITY_SERVICE_URL=http://127.0.0.1:4001
# PRIVATE Ed25519 JWK of content-service (`npm run keys:generate -- content-service`). Its PUBLIC
# half goes into SERVICE_TOKEN_TRUSTED_KEYS of identity-service as "content-service".
SERVICE_TOKEN_PRIVATE_JWK=

# Folder of handbook PDF/image uploads while they are imported (ADR-0029). Empty: OS temp folder.
# Production: a Docker volume (files are deleted after import, at the latest after 24 hours).
HANDBOOK_UPLOAD_DIR=

# Cache revalidation of the public handbook on `web` after a publish (HMAC, same value as
# REVALIDATE_SECRET in apps/web and program-service).
WEB_APP_URL=http://localhost:3000
REVALIDATE_SECRET=
