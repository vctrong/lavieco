# identity-service in production. Copy to /opt/lavieco/env/identity-service.env on the
# server (chmod 600). Real values NEVER go into the repo. Meaning: docs/06-bien-moi-truong.md.
# JSON values (keys) go in single quotes: SERVICE_TOKEN_TRUSTED_KEYS='{"web": {...}}'.

NODE_ENV=production
PORT=4001
LOG_LEVEL=info

# Atlas (Singapore), user with rights on lavieco_identity ONLY (docs/03, runbook §3).
# Never a *_dev database in production: the service refuses to start.
MONGODB_URI=
MONGODB_DB=lavieco_identity

# USER TOKEN SIGNING KEY (not a service token): JSON array with the PRIVATE_JWK of
# `npm run keys:generate -- identity-service`, e.g. '[<PRIVATE_JWK>]'. The first key signs;
# during a rotation keep the old one second. Its public half is published by the service
# itself at /.well-known/jwks.json, nothing to copy elsewhere.
JWT_SIGNING_KEYS=

# PUBLIC JWKs of the callers allowed to use a service token here, as one JSON object:
#   '{"web": <PUBLIC_JWK of web>, "admin": <PUBLIC_JWK of admin>, "program-service": <PUBLIC_JWK of program-service>}'
# Each must be the public half of SERVICE_TOKEN_PRIVATE_JWK in web.env, admin.env and
# program-service.env respectively. A private JWK here makes the service refuse to start.
SERVICE_TOKEN_TRUSTED_KEYS=

# base64 of 32 random bytes each (RANDOM_32B values of keys:generate), unique to this file.
# Changing TOTP_ENCRYPTION_KEY makes every enrolled 2FA unreadable.
TOTP_ENCRYPTION_KEY=
OTP_PEPPER=

STAFF_ACCESS_TTL_SECONDS=600
MEMBER_ACCESS_TTL_SECONDS=900
STAFF_REFRESH_TTL_HOURS=12
MEMBER_REFRESH_TTL_DAYS=30

# Public origins, used in emails and invitation links.
ADMIN_APP_URL=https://admin.lavieco.io.vn
WEB_APP_URL=https://lavieco.io.vn

# Google sign-in (ADR-0016). GOOGLE_CLIENT_ID and GOOGLE_REDIRECT_URI MUST EQUAL web.env;
# the secret lives here only. Empty = disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://lavieco.io.vn/api/auth/google/callback

# Real SMTP provider on lavieco.io.vn with SPF/DKIM (docs/06 "Gửi email thật (SMTP)", AQ8).
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LAVIECO <no-reply@lavieco.io.vn>"
