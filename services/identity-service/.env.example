# identity-service. Copy with `npm run env:init`; real values only in `.env.local` (never committed).
# Generate key material from the repo root with: npm run keys:generate -- <caller name>

NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# Local replica set from `npm run dev:infra`. Production: Atlas (Singapore), user with rights on lavieco_identity only.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_DB=lavieco_identity
# Atlas dev instead (needs your IP in the Atlas allowlist and a *_dev database, docs/dev-local.md):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=lavieco_identity_dev

# JSON array of PRIVATE Ed25519 JWKs signing user tokens; the first one signs (ADR-0018).
JWT_SIGNING_KEYS=
# Public JWKs of the BFFs allowed to call this service: {"web": {...}, "admin": {...}}
SERVICE_TOKEN_TRUSTED_KEYS=

# base64 of 32 random bytes each.
TOTP_ENCRYPTION_KEY=
OTP_PEPPER=

STAFF_ACCESS_TTL_SECONDS=600
MEMBER_ACCESS_TTL_SECONDS=900
STAFF_REFRESH_TTL_HOURS=12
MEMBER_REFRESH_TTL_DAYS=30

ADMIN_APP_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000

# Google sign-in for members (ADR-0016). Leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Mail (OTP, invitations, member emails): Mailpit in development (http://localhost:8025). Real delivery:
# fill SMTP_* and MAIL_FROM as in docs/06 "Gửi email thật (SMTP)" (Gmail App Password
# for dev only; a transactional provider on lavieco.io.vn with SPF/DKIM for prod), then
# run npm run mail:test -- <email>. SMTP_USER and SMTP_PASS go together; 465 needs
# SMTP_SECURE=true.
# The whole mail block MUST EQUAL services/program-service/.env.local.
MAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LAVIECO <no-reply@lavieco.io.vn>"
# Sender on the SMTP_* route (the Gmail address itself). Empty = MAIL_FROM.
MAIL_FROM_FALLBACK=
MAIL_REPLY_TO=
# Brevo in front of SMTP_* (ADR-0023). Empty BREVO_SMTP_KEY = SMTP_* only (Mailpit).
# With a key, MAIL_FROM_FALLBACK is required. Test one route:
# npm run mail:test -- <email> --provider=brevo|gmail
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_COOLDOWN_MINUTES=15
