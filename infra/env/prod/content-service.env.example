# content-service in production. Copy to /opt/lavieco/env/content-service.env on the
# server (chmod 600). Real values NEVER go into the repo. Meaning: docs/06-bien-moi-truong.md.

NODE_ENV=production
PORT=4002
LOG_LEVEL=info

# Atlas (Singapore), user `svc_content` with rights on lavieco_content ONLY.
MONGODB_URI=
MONGODB_DB=lavieco_content

# PUBLIC JWKs of the callers allowed to use a service token here (one JSON object, single quotes):
#   '{"program-service": <PUBLIC_JWK of program-service>, "web": <PUBLIC_JWK of web>}'
# = the public halves of SERVICE_TOKEN_PRIVATE_JWK in program-service.env and web.env. "web"
# reads the published handbook (ADR-0029). admin calls this service with user tokens only.
SERVICE_TOKEN_TRUSTED_KEYS=

# identity-service JWKS on the private network (user tokens of staff and members).
IDENTITY_JWKS_URL=http://identity-service:4001/.well-known/jwks.json

# Cloudinary PRODUCTION product environment (ADR-0020), never the dev one.
# CLOUDINARY_CLOUD_NAME MUST EQUAL the NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME build variable of
# web and admin. The API secret lives here only. Run `media:setup` once (runbook §5).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Handbook (ADR-0029) ---
# identity-service on the private network: handbook audit events and staff alerts (outbox).
IDENTITY_SERVICE_URL=http://identity-service:4001
# SERVICE TOKEN KEY of caller "content-service": the PRIVATE_JWK line of
# `npm run keys:generate -- content-service`, in single quotes. Its PUBLIC_JWK goes under
# "content-service" in SERVICE_TOKEN_TRUSTED_KEYS of identity-service.env.
SERVICE_TOKEN_PRIVATE_JWK=
# Cache revalidation of the public handbook after a publish: the public site, and the SAME
# value as REVALIDATE_SECRET in web.env (and program-service.env).
WEB_APP_URL=https://lavieco.io.vn
REVALIDATE_SECRET=
# PDF/image uploads waiting to be imported: the handbook_uploads volume (compose.prod.yml).
HANDBOOK_UPLOAD_DIR=/var/lib/lavieco/handbook-uploads
