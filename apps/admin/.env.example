# admin (internal back office). Real values only in `.env.local` (never committed).
# Read on the server through src/lib/env.ts; there is no NEXT_PUBLIC_* variable here.

# identity-service on the private network.
IDENTITY_SERVICE_URL=http://127.0.0.1:4001
# program-service on the private network (events, ticket types).
PROGRAM_SERVICE_URL=http://127.0.0.1:4004
# content-service on the private network: event image uploads (ADR-0020).
CONTENT_SERVICE_URL=http://127.0.0.1:4002
# Cloudinary cloud name of the matching environment (dev here). Not a secret: it is part of
# every image URL. NEXT_PUBLIC_* is embedded in the bundle at build time.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Public origin of admin itself: base of every redirect (never the request host,
# which is 0.0.0.0:3001 behind the reverse proxy). Empty = http://localhost:3001.
ADMIN_APP_URL=http://localhost:3001

# Public site: the event preview is shown from there in an iframe.
WEB_APP_URL=http://localhost:3000
# PRIVATE Ed25519 JWK of `admin`, signing its service tokens (ADR-0018). Its PUBLIC half
# goes into SERVICE_TOKEN_TRUSTED_KEYS of identity-service.
SERVICE_TOKEN_PRIVATE_JWK=

LOG_LEVEL=info
