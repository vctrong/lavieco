# admin (internal back office). Real values only in `.env.local` (never committed).
# Read on the server through src/lib/env.ts; there is no NEXT_PUBLIC_* variable here.

# identity-service on the private network.
IDENTITY_SERVICE_URL=http://127.0.0.1:4001
# PRIVATE Ed25519 JWK of `admin`, signing its service tokens (ADR-0018). Its PUBLIC half
# goes into SERVICE_TOKEN_TRUSTED_KEYS of identity-service.
SERVICE_TOKEN_PRIVATE_JWK=

LOG_LEVEL=info
