exports[`ticketEmail > 'paid-offline-many-safety-member' renders a safe email (snapshot) > html 1`] = `
"<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>Vé của bạn: Workshop làm chậu cây từ bột vỏ sò</title>
<style>@media (max-width:620px){.lv-pad{padding-left:20px!important;padding-right:20px!important}.lv-h1{font-size:24px!important;line-height:32px!important}}</style>
