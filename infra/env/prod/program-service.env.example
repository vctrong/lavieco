# program-service in production. Copy to /opt/lavieco/env/program-service.env on the
# server (chmod 600). Real values NEVER go into the repo. Meaning: docs/06-bien-moi-truong.md.

NODE_ENV=production
PORT=4004
LOG_LEVEL=info

# Atlas (Singapore), user `svc_program` with rights on lavieco_program ONLY.
MONGODB_URI=
MONGODB_DB=lavieco_program

# PUBLIC JWKs of the callers allowed to use a service token here (one JSON object, single quotes):
#   '{"web": <PUBLIC_JWK of web>, "admin": <PUBLIC_JWK of admin>}'
# = the public halves of SERVICE_TOKEN_PRIVATE_JWK in web.env and admin.env.
SERVICE_TOKEN_TRUSTED_KEYS=

# Other services on the private network.
IDENTITY_JWKS_URL=http://identity-service:4001/.well-known/jwks.json
IDENTITY_SERVICE_URL=http://identity-service:4001
CONTENT_SERVICE_URL=http://content-service:4002

# SERVICE TOKEN KEY of caller "program-service": the PRIVATE_JWK line of
# `npm run keys:generate -- program-service`, single quotes. Its PUBLIC_JWK goes under
# "program-service" in SERVICE_TOKEN_TRUSTED_KEYS of content-service.env AND identity-service.env.
SERVICE_TOKEN_PRIVATE_JWK=

# Public origin of web: links in ticket emails and the cache revalidation webhook
# (POST https://lavieco.io.vn/api/revalidate, goes out through the public edge).
WEB_APP_URL=https://lavieco.io.vn
# MUST EQUAL REVALIDATE_SECRET in web.env.
REVALIDATE_SECRET=

# HMAC of the order links in ticket emails: base64 of 32 random bytes, unique to this file.
# Changing it invalidates every link already emailed.
TICKET_LINK_SECRET=

# payOS payment channel (ADR-0015, docs/runbooks/payos.md). All three or none.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Mail (ADR-0023, docs/06 "Gửi email thật (SMTP)"). This whole block MUST EQUAL in
# identity-service.env and program-service.env. Brevo (verified lavieco.io.vn, SPF/DKIM)
# sends first; any Brevo failure (quota of 300/day included) falls back to Gmail SMTP.
# Check each route: docs/runbooks/deploy-vps.md, "mail-test".
MAIL_PROVIDER=smtp
MAIL_FROM="LAVIECO <no-reply@lavieco.io.vn>"
# Gmail route sender: the Gmail address of SMTP_USER itself (DMARC), never @lavieco.io.vn.
MAIL_FROM_FALLBACK="LAVIECO <lavieco.section@gmail.com>"
MAIL_REPLY_TO=lavieco.section@gmail.com
# Primary: Brevo > SMTP & API > SMTP (login ...@smtp-brevo.com + SMTP key, not the v3 API key).
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_COOLDOWN_MINUTES=15
# Fallback: Gmail SMTP with an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
