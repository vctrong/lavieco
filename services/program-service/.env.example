# program-service. Copy with `npm run env:init`; real values only in `.env.local` (never committed).

NODE_ENV=development
PORT=4004
LOG_LEVEL=info

# Local replica set from `npm run dev:infra`. Production: Atlas (Singapore), user `svc_program` with rights on lavieco_program only.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=lavieco_program

# Public JWKs of the BFFs allowed to call this service: {"web": {...}, "admin": {...}} (ADR-0018)
SERVICE_TOKEN_TRUSTED_KEYS=
# Staff/member access tokens are verified against identity-service's JWKS.
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json

# content-service on the private network: event images are attached/released there (ADR-0020).
CONTENT_SERVICE_URL=http://127.0.0.1:4002
# PRIVATE Ed25519 JWK of program-service, signing its service tokens (ADR-0018). Its PUBLIC half
# goes into SERVICE_TOKEN_TRUSTED_KEYS of content-service as "program-service".
SERVICE_TOKEN_PRIVATE_JWK=

# Cache revalidation of public event pages on `web` (HMAC, same value as REVALIDATE_SECRET in apps/web).
WEB_APP_URL=http://localhost:3000
REVALIDATE_SECRET=

# HMAC key of the order links in ticket emails (/ve/[token], payment page): base64 of 32 random
# bytes (RANDOM_32B of keys:generate). Changing it invalidates every link already emailed.
TICKET_LINK_SECRET=

# Ticket emails. Mailpit in development (http://localhost:8025).
MAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LAVIECO <no-reply@lavieco.io.vn>"
